#!/usr/bin/env bash
# Pre-commit hook: format check + unit tests
# Install: git config core.hooksPath .githooks
#
# Set $ZIG to point at a specific zig binary if the system zig
# (e.g. broken proto shim) is unavailable.

set -euo pipefail

ZIG_BIN="${ZIG:-zig}"

echo "==> Checking zig fmt..."
if ! "$ZIG_BIN" fmt --check src/ bench/ build.zig 2>/dev/null; then
    echo ""
    echo "ERROR: Zig formatting check failed."
    echo "Run: $ZIG_BIN fmt src/ bench/ build.zig"
    echo ""
    exit 1
fi

echo "==> Type-checking via zig build-lib..."
# Run tests locally via `zig test src/lib.zig -lc`. CI runs them on
# every push (.github/workflows/ci.yml). We don't try to run them
# inside the hook because `zig test`'s IPC mode (which kicks in
# when stdout is redirected — as it is here) hangs on this
# host's `--listen=-` handshake under any moderate load. Faster
# pre-commit gate + reliable CI is a better trade than hooks that
# hang and force people to --no-verify.
#
# `zig build-lib -fno-emit-bin` catches type errors / syntax /
# parsing problems in O(seconds) without invoking the test runner.
if ! "$ZIG_BIN" build-lib src/lib.zig -lc -fno-emit-bin 2>&1; then
    echo ""
    echo "ERROR: Type-check failed."
    echo ""
    exit 1
fi

echo "==> All checks passed."
