# Force LF line endings for text files on every platform.
#
# Without this, Windows git clients convert LF → CRLF on checkout and
# `zig fmt --check` reports every file as needing reformatting. Volt
# is developed on Darwin (LF-only); enforcing LF everywhere keeps
# Windows builds + lint passing.

* text=auto eol=lf

*.zig text eol=lf
*.zon text eol=lf
*.S   text eol=lf
*.md  text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.sh  text eol=lf

# Binary assets — never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
