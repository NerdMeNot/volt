#!/usr/bin/env bash
# Pre-commit hook: format check + unit tests
# Install: git config core.hooksPath .githooks
#
# Set $ZIG to point at a specific zig binary if the system zig
# (e.g. broken proto shim) is unavailable.

set -euo pipefail

ZIG_BIN="${ZIG:-zig}"

echo "==> Checking zig fmt..."
if ! "$ZIG_BIN" fmt --check src/ bench/ build.zig 2>/dev/null; then
    echo ""
    echo "ERROR: Zig formatting check failed."
    echo "Run: $ZIG_BIN fmt src/ bench/ build.zig"
    echo ""
    exit 1
fi

echo "==> Running unit tests (with 90s timeout)..."
# Use `zig test` directly rather than `zig build test`. The build
# command spawns the test binary with --listen=- (IPC protocol);
# on heavily-loaded hosts the handshake hangs indefinitely.
#
# Wrapping in `timeout`: the test binary occasionally hangs on
# specific RNG seeds (non-deterministic scheduling exposes a latent
# race surfacing in 1-of-N runs). 90s is plenty for the 30s nominal
# run; a hang fails the commit so we notice instead of waiting
# forever. If you see frequent timeout failures, run tests directly
# (`zig test src/lib.zig -lc`) and capture the seed.
test_log=$(mktemp -t volt-precommit-tests.XXXXXX)
trap 'rm -f "$test_log"' EXIT
if /usr/bin/perl -e 'alarm shift; exec @ARGV' 90 "$ZIG_BIN" test src/lib.zig -lc >"$test_log" 2>&1; then
    tail -5 "$test_log"
else
    echo ""
    echo "ERROR: Unit tests failed or timed out. Output (last 40 lines):"
    echo ""
    tail -40 "$test_log"
    echo ""
    exit 1
fi

echo "==> All checks passed."
